# AI Dataset Explorer — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (for NextAuth provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini — get key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kaggle — get credentials at https://www.kaggle.com/settings (API section)
# Either set KAGGLE_API_TOKEN (KGAT_... Bearer token) OR KAGGLE_USERNAME + KAGGLE_KEY
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face — get token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Academic Literature APIs (optional/recommended for higher rate limits)
# Note: ArXiv and Crossref require zero API keys and use CONTACT_EMAIL / OPENALEX_EMAIL for polite-pool headers.
CONTACT_EMAIL=research@example.com
OPENALEX_API_KEY=
OPENALEX_EMAIL=research@example.com
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# Debug (set false in production)
DEBUG_API_TRACE=false

# Mock mode (set false for live API usage)
USE_MOCK_AI=false